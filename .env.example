# Telegram lead-form integration (форма заявки → Telegram)
# 1) Створіть бота через @BotFather і скопіюйте токен
# 2) Дізнайтесь chat_id (напишіть боту, відкрийте
#    https://api.telegram.org/bot<TOKEN>/getUpdates і візьміть chat.id)
# 3) Скопіюйте цей файл у .env.local та заповніть значення

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
